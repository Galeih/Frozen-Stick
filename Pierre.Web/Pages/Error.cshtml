@page "{statusCode?}"
@model Pierre.Web.Pages.ErrorModel
@{
    ViewData["Title"] = "Erreur";
    var layout = Request.Path.StartsWithSegments("/Admin") ? "~/Pages/Admin/_AdminLayout.cshtml" : "~/Pages/Shared/_PublicLayout.cshtml";
    Layout = layout;
}

<div class="container py-5 text-center">
    <h1 class="display-1 text-muted">@(Model.HttpStatusCode > 0 ? Model.HttpStatusCode.ToString() : "Erreur")</h1>

    @if (Model.HttpStatusCode == 404)
    {
        <h2 class="text-danger">Page introuvable</h2>
        <p class="text-muted">La page que vous recherchez n'existe pas ou a été déplacée.</p>
    }
    else if (Model.HttpStatusCode == 403)
    {
        <h2 class="text-danger">Accès refusé</h2>
        <p class="text-muted">Vous n'avez pas les droits pour accéder à cette page.</p>
    }
    else
    {
        <h2 class="text-danger">Une erreur est survenue</h2>
        <p class="text-muted">Une erreur inattendue s'est produite. Veuillez réessayer plus tard.</p>
    }

    <a href="@(Request.Path.StartsWithSegments("/Admin") ? "/Admin/Dashboard" : "/")" class="btn btn-primary mt-3">
        @(Request.Path.StartsWithSegments("/Admin") ? "Retour au tableau de bord" : "Retour à l'accueil")
    </a>
</div>
