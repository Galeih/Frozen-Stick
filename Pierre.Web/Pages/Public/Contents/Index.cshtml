@page "/contenus"
@model Pierre.Web.Pages.Public.Contents.IndexModel
@{
    ViewData["Title"] = "Contenus";
}

<h1 class="mb-4">Contenus</h1>

<form method="get" class="mb-4">
    <div class="btn-group" role="group">
        <a asp-page="Index" class="btn @(string.IsNullOrEmpty(Model.TypeFilter) ? "btn-primary" : "btn-outline-primary")">Tout</a>
        <a asp-page="Index" asp-route-typeFilter="Recipe" class="btn @(Model.TypeFilter == "Recipe" ? "btn-primary" : "btn-outline-primary")">Recettes</a>
        <a asp-page="Index" asp-route-typeFilter="Article" class="btn @(Model.TypeFilter == "Article" ? "btn-primary" : "btn-outline-primary")">Articles</a>
        <a asp-page="Index" asp-route-typeFilter="News" class="btn @(Model.TypeFilter == "News" ? "btn-primary" : "btn-outline-primary")">Actualités</a>
        <a asp-page="Index" asp-route-typeFilter="Workshop" class="btn @(Model.TypeFilter == "Workshop" ? "btn-primary" : "btn-outline-primary")">Ateliers</a>
        <a asp-page="Index" asp-route-typeFilter="Tip" class="btn @(Model.TypeFilter == "Tip" ? "btn-primary" : "btn-outline-primary")">Conseils</a>
    </div>
</form>

@if (Model.Contents.Count == 0)
{
    <p class="text-muted">Aucun contenu publié pour le moment.</p>
}
else
{
    <div class="row row-cols-1 row-cols-md-3 g-4">
        @foreach (var content in Model.Contents)
        {
            <div class="col">
                <div class="card h-100">
                    <div class="card-body">
                        <span class="badge bg-secondary mb-2">@content.Type</span>
                        <h5 class="card-title">@content.Title</h5>
                        @if (content.PublishedAt.HasValue)
                        {
                            <p class="card-text text-muted small">Publié le @content.PublishedAt.Value.ToString("dd/MM/yyyy")</p>
                        }
                        <a asp-page="Detail" asp-route-slug="@content.Slug" class="stretched-link"></a>
                    </div>
                </div>
            </div>
        }
    </div>
}
