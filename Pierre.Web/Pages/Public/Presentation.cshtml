@page
@{
    ViewData["Title"] = "Présentation";
}

<div class="page-header">
    <div class="container">
        <h1>Présentation</h1>
    </div>
</div>

<section class="py-5">
    <div class="container">
        <div class="row align-items-start">
            <div class="col-lg-4 text-center mb-4">
                <div class="bg-green-light d-inline-flex align-items-center justify-content-center" style="width: 250px; height: 250px; border-radius: 50%;">
                    <span class="text-primary-green fw-bold">Photo</span>
                </div>
            </div>
            <div class="col-lg-8">
                <h2 class="section-title">Diététicien-nutritionniste diplômé</h2>
                <p class="mt-3">
                    Diplômé du BTS Diététique et fort de plusieurs années d'expérience en milieu hospitalier
                    et en cabinet libéral, j'ai à coeur d'accompagner chaque personne vers un mieux-être
                    alimentaire durable.
                </p>
                <p>
                    Ma pratique s'appuie sur une approche bienveillante, sans régime restrictif ni culpabilisation.
                    Je crois fermement que l'alimentation doit rester un plaisir tout en étant adaptée aux
                    besoins spécifiques de chacun.
                </p>

                <h3 class="fw-bold mt-4" style="color: var(--green-dark);">Formation et parcours</h3>
                <ul class="list-unstyled mt-3">
                    <li class="mb-2"><strong>2020 - aujourd'hui</strong> — Cabinet libéral à Paris</li>
                    <li class="mb-2"><strong>2017 - 2020</strong> — Diététicien à l'hôpital Saint-Antoine</li>
                    <li class="mb-2"><strong>2015 - 2017</strong> — BTS Diététique, École de Dietétique Paris</li>
                </ul>

                <h3 class="fw-bold mt-4" style="color: var(--green-dark);">Mon approche</h3>
                <ul class="mt-3">
                    <li class="mb-2">Écoute et bienveillance</li>
                    <li class="mb-2">Accompagnement personnalisé sans régime restrictif</li>
                    <li class="mb-2">Suivi adapté à votre rythme de vie</li>
                    <li class="mb-2">Conseils pratiques et concrets pour le quotidien</li>
                </ul>
            </div>
        </div>
    </div>
</section>
