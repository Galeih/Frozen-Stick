@page
@model Pierre.Web.Pages.Admin.Clients.IndexModel
@{
    ViewData["Title"] = "Gestion des clients";
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <h1>Gestion des clients</h1>
    <a asp-page="Create" class="btn btn-primary">Nouveau client</a>
</div>

@if (TempData["Success"] is string successMsg)
{
    <div class="alert alert-success alert-dismissible fade show" role="alert">
        @successMsg
        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
    </div>
}

<form method="get" class="row g-2 mb-3">
    <div class="col-auto">
        <input type="text" name="SearchQuery" value="@Model.SearchQuery" class="form-control" placeholder="Rechercher un nom..." />
    </div>
    <div class="col-auto">
        <button type="submit" class="btn btn-outline-secondary">Rechercher</button>
    </div>
    <div class="col-auto">
        <div class="form-check mt-2">
            <input type="checkbox" name="IncludeArchived" value="true" class="form-check-input" id="includeArchived"
                    checked="@Model.IncludeArchived" onchange="this.form.submit()" />
            <label class="form-check-label" for="includeArchived">Afficher les archivés</label>
        </div>
    </div>
</form>

@if (Model.Clients.Count == 0)
{
    <p class="text-muted">Aucun client trouvé.</p>
}
else
{
    <table class="table table-hover">
        <thead>
            <tr>
                <th>Nom</th>
                <th>Prénom</th>
                <th>Email</th>
                <th>Téléphone</th>
                <th>Date de création</th>
                <th>Statut</th>
                <th>Actions</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var client in Model.Clients)
            {
                <tr class="@(client.IsArchived ? "table-secondary" : "")">
                    <td>@client.LastName</td>
                    <td>@client.FirstName</td>
                    <td>@(string.IsNullOrEmpty(client.Email) ? "-" : client.Email)</td>
                    <td>@(string.IsNullOrEmpty(client.Phone) ? "-" : client.Phone)</td>
                    <td>@client.CreatedAt.ToString("dd/MM/yyyy")</td>
                    <td>
                        @if (client.IsArchived)
                        {
                            <span class="badge bg-secondary">Archivé</span>
                        }
                        else
                        {
                            <span class="badge bg-success">Actif</span>
                        }
                    </td>
                    <td>
                        <a asp-page="Detail" asp-route-id="@client.Id" class="btn btn-sm btn-outline-primary">Voir</a>
                    </td>
                </tr>
            }
        </tbody>
    </table>
}
