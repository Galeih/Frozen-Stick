@page "{id:guid}"
@model Pierre.Web.Pages.Admin.Clients.DetailModel
@{
    ViewData["Title"] = "Fiche client";
}

<h1>Fiche client</h1>

@if (TempData["Success"] is string successMsg)
{
    <div class="alert alert-success alert-dismissible fade show" role="alert">
        @successMsg
        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
    </div>
}

<div class="card mb-4">
    <div class="card-header d-flex justify-content-between align-items-center">
        <span>@Model.Client.FirstName @Model.Client.LastName</span>
        @if (Model.Client.IsArchived)
        {
            <span class="badge bg-secondary">Archivé</span>
        }
        else
        {
            <span class="badge bg-success">Actif</span>
        }
    </div>
    <div class="card-body">
        <div class="row">
            <div class="col-md-6">
                <h5>Coordonnées</h5>
                <p>
                    @if (!string.IsNullOrEmpty(Model.Client.Email))
                    {
                        <strong>Email :</strong> <a href="mailto:@Model.Client.Email">@Model.Client.Email</a><br />
                    }
                    @if (!string.IsNullOrEmpty(Model.Client.Phone))
                    {
                        <strong>Téléphone :</strong> <a href="tel:@Model.Client.Phone">@Model.Client.Phone</a><br />
                    }
                    @if (Model.Client.BirthDate.HasValue)
                    {
                        <strong>Date de naissance :</strong> @Model.Client.BirthDate.Value.ToString("dd/MM/yyyy")<br />
                    }
                    <strong>Client depuis le :</strong> @Model.Client.CreatedAt.ToString("dd/MM/yyyy")<br />
                    @if (Model.Client.UpdatedAt != Model.Client.CreatedAt)
                    {
                        <strong>Dernière modification :</strong> @Model.Client.UpdatedAt.ToString("g")
                    }
                </p>
            </div>
            <div class="col-md-6">
                <h5>Statistiques</h5>
                <p>
                    <strong>Rendez-vous :</strong> @Model.Client.AppointmentCount<br />
                    <strong>Notes de consultation :</strong> @Model.Client.ConsultationNotes.Count
                </p>
            </div>
        </div>

        @if (!string.IsNullOrEmpty(Model.Client.Notes))
        {
            <div class="row mt-3">
                <div class="col-12">
                    <h5>Notes</h5>
                    <p>@Model.Client.Notes</p>
                </div>
            </div>
        }
    </div>

    <div class="card-footer">
        <a asp-page="Edit" asp-route-id="@Model.Client.Id" class="btn btn-primary">Modifier</a>

        @if (!Model.Client.IsArchived)
        {
            <form method="post" asp-page-handler="Archive" class="d-inline" onsubmit="return confirm('Archiver ce client ? Il sera masqué par défaut dans la liste.');">
                <button type="submit" class="btn btn-warning">Archiver</button>
            </form>
        }
    </div>
</div>

@if (Model.Client.Appointments.Count > 0)
{
    <div class="card mb-4">
        <div class="card-header">
            <h5 class="mb-0">Historique des rendez-vous (@Model.Client.Appointments.Count)</h5>
        </div>
        <div class="card-body p-0">
            <table class="table table-hover mb-0">
                <thead>
                    <tr>
                        <th>Date</th>
                        <th>Horaire</th>
                        <th>Statut</th>
                        <th>Demandé le</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var appt in Model.Client.Appointments)
                    {
                        <tr>
                            <td>@appt.Date.ToString("dd/MM/yyyy")</td>
                            <td>@appt.StartTime.ToString("HH\\hmm") - @appt.EndTime.ToString("HH\\hmm")</td>
                            <td>
                                <span class="badge @(appt.Status switch
                                {
                                    "Accepted" => "bg-success",
                                    "Pending" => "bg-warning text-dark",
                                    "Refused" => "bg-secondary",
                                    _ => "bg-info"
                                })">@appt.Status</span>
                            </td>
                            <td>@appt.CreatedAt.ToString("g")</td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
}

<div class="card mb-4">
    <div class="card-header d-flex justify-content-between align-items-center">
        <h5 class="mb-0">Notes de consultation (@Model.Client.ConsultationNotes.Count)</h5>
        <a asp-page="/Admin/ConsultationNotes/Create" asp-route-clientId="@Model.Client.Id" class="btn btn-sm btn-primary">
            Ajouter une note
        </a>
    </div>

    @if (Model.Client.ConsultationNotes.Count > 0)
    {
        <div class="card-body p-0">
            <table class="table table-hover mb-0">
                <thead>
                    <tr>
                        <th>Date</th>
                        <th>Contenu</th>
                        <th>Recommandations</th>
                        <th>Poids</th>
                        <th>Actions</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var note in Model.Client.ConsultationNotes)
                    {
                        <tr>
                            <td>@note.Date.ToString("dd/MM/yyyy")</td>
                            <td>@(note.Content.Length > 100 ? note.Content[..100] + "..." : note.Content)</td>
                            <td>@(note.Recommendations ?? "-")</td>
                            <td>@(note.Weight.HasValue ? note.Weight.Value.ToString("F1") + " kg" : "-")</td>
                            <td>
                                <a asp-page="/Admin/ConsultationNotes/Detail" asp-route-id="@note.Id" class="btn btn-sm btn-outline-primary">Voir</a>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }
    else
    {
        <div class="card-body">
            <p class="text-muted mb-0">Aucune note de consultation. <a asp-page="/Admin/ConsultationNotes/Create" asp-route-clientId="@Model.Client.Id">Ajouter une note</a>.</p>
        </div>
    }
</div>

@if (Model.Client.Invoices.Count > 0)
{
    <div class="card mb-4">
        <div class="card-header d-flex justify-content-between align-items-center">
            <h5 class="mb-0">Factures (@Model.Client.Invoices.Count)</h5>
            <a asp-page="/Admin/AdminTracking/Index" class="btn btn-sm btn-outline-primary">Voir tout</a>
        </div>
        <div class="card-body p-0">
            <table class="table table-hover mb-0">
                <thead>
                    <tr>
                        <th>Référence</th>
                        <th>Montant</th>
                        <th>Statut</th>
                        <th>Date</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var inv in Model.Client.Invoices)
                    {
                        <tr>
                            <td>@inv.Reference</td>
                            <td>@inv.Amount.ToString("F2") €</td>
                            <td>
                                <span class="badge @(inv.Status switch
                                {
                                    "Paid" => "bg-success",
                                    "Pending" => "bg-warning text-dark",
                                    "Cancelled" => "bg-secondary",
                                    _ => "bg-info"
                                })">@inv.Status</span>
                            </td>
                            <td>@inv.IssuedAt.ToString("dd/MM/yyyy")</td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
}

<div>
    <a asp-page="Index" class="btn btn-outline-secondary">Retour à la liste</a>
</div>
