@page
@model Pierre.Web.Pages.Admin.AdminTracking.IndexModel
@{
    ViewData["Title"] = "Suivi administratif";
}

<h1>Suivi administratif</h1>

@if (TempData["Success"] is string successMsg)
{
    <div class="alert alert-success alert-dismissible fade show" role="alert">
        @successMsg
        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
    </div>
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <div class="btn-group" role="group">
        <a asp-page="Index" asp-route-status="" class="btn btn-outline-secondary @(Model.CurrentStatus == null ? "active" : "")">Tous</a>
        <a asp-page="Index" asp-route-status="Pending" class="btn btn-outline-warning @(Model.CurrentStatus == "Pending" ? "active" : "")">En attente</a>
        <a asp-page="Index" asp-route-status="Paid" class="btn btn-outline-success @(Model.CurrentStatus == "Paid" ? "active" : "")">Payées</a>
        <a asp-page="Index" asp-route-status="Cancelled" class="btn btn-outline-secondary @(Model.CurrentStatus == "Cancelled" ? "active" : "")">Annulées</a>
    </div>
    <a asp-page="Create" class="btn btn-primary">Nouvelle entrée</a>
</div>

@if (Model.Invoices.Count > 0)
{
    <div class="table-responsive">
        <table class="table table-hover">
            <thead>
                <tr>
                    <th>Référence</th>
                    <th>Client</th>
                    <th>Montant</th>
                    <th>Statut</th>
                    <th>Date</th>
                    <th>Actions</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var invoice in Model.Invoices)
                {
                    <tr>
                        <td>@invoice.Reference</td>
                        <td>
                            <a asp-page="/Admin/Clients/Detail" asp-route-id="@invoice.ClientId">
                                @invoice.ClientName
                            </a>
                        </td>
                        <td>@invoice.Amount.ToString("F2") €</td>
                        <td>
                            <span class="badge @(invoice.Status switch
                            {
                                "Paid" => "bg-success",
                                "Pending" => "bg-warning text-dark",
                                "Cancelled" => "bg-secondary",
                                _ => "bg-info"
                            })">@invoice.Status</span>
                        </td>
                        <td>@invoice.IssuedAt.ToString("dd/MM/yyyy")</td>
                        <td>
                            <a asp-page="Edit" asp-route-id="@invoice.Id" class="btn btn-sm btn-outline-primary">Modifier</a>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
}
else
{
    <div class="card">
        <div class="card-body text-center py-5">
            <p class="text-muted mb-0">Aucune entrée administrative trouvée.</p>
            <a asp-page="Create" class="btn btn-primary mt-3">Créer la première entrée</a>
        </div>
    </div>
}
