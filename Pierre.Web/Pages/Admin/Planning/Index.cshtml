@page
@model Pierre.Web.Pages.Admin.Planning.IndexModel
@{
    ViewData["Title"] = "Planning";
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <h1>Planning</h1>
    <a asp-page="CreateSlot" class="btn btn-primary">Nouveau créneau</a>
</div>

@if (TempData["Success"] is string successMsg)
{
    <div class="alert alert-success alert-dismissible fade show" role="alert">
        @successMsg
        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
    </div>
}

<form method="get" class="row g-2 mb-3">
    <div class="col-auto">
        <label for="weekOffset" class="visually-hidden">Semaine</label>
        <select name="weekOffset" class="form-select" onchange="this.form.submit()">
            @for (int i = -1; i <= 4; i++)
            {
                var label = i switch
                {
                    -1 => "Semaine dernière",
                    0 => "Cette semaine",
                    1 => "Semaine prochaine",
                    _ => $"Dans {i} semaines"
                };
                <option value="@i" selected="@(Model.WeekOffset == i)">@label</option>
            }
        </select>
    </div>
    <div class="col-auto">
        <a asp-page="CreateSlot" asp-route-date="@Model.WeekStart.ToString("yyyy-MM-dd")" class="btn btn-outline-primary">
            Ajouter un créneau cette semaine
        </a>
    </div>
</form>

@if (Model.Slots.Count == 0)
{
    <p class="text-muted">Aucun créneau pour cette semaine.</p>
}
else
{
    <div class="table-responsive">
        <table class="table table-hover">
            <thead>
                <tr>
                    <th>Jour</th>
                    <th>Date</th>
                    <th>Horaire</th>
                    <th>Statut</th>
                    <th>Rendez-vous</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var slot in Model.Slots)
                {
                    <tr class="@(slot.IsBlocked ? "table-secondary" : slot.HasAppointment ? "table-success" : "")">
                        <td>@slot.Date.ToString("dddd")</td>
                        <td>@slot.Date.ToString("dd/MM/yyyy")</td>
                        <td>@slot.StartTime.ToString("HH\\hmm") - @slot.EndTime.ToString("HH\\hmm")</td>
                        <td>
                            @if (slot.IsBlocked)
                            {
                                <span class="badge bg-secondary">Bloqué</span>
                            }
                            else if (slot.HasAppointment)
                            {
                                <span class="badge bg-success">Réservé</span>
                            }
                            else
                            {
                                <span class="badge bg-info">Libre</span>
                            }
                        </td>
                        <td>
                            @if (slot.HasAppointment)
                            {
                                <span>@slot.AppointmentStatus</span>
                            }
                            else
                            {
                                <span class="text-muted">-</span>
                            }
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
}
