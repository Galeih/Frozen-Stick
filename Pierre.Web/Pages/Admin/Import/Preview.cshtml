@page
@model Pierre.Web.Pages.Admin.Import.PreviewModel
@{
    ViewData["Title"] = "Prévisualisation de l'import";
}

<h1>Prévisualisation de l'import</h1>

<p class="text-muted">Fichier : <strong>@Model.FileName</strong></p>

<div class="d-flex gap-3 mb-3">
    <div class="badge bg-primary fs-6">Total : @Model.ValidRows.Count</div>
    <div class="badge bg-success fs-6">Valides : @Model.ValidRows.Count(v => v.RowNumber > 0)</div>
    <div class="badge bg-danger fs-6">Erreurs : @Model.Errors.Count</div>
    <div class="badge bg-warning text-dark fs-6">Doublons : @Model.Duplicates.Count</div>
</div>

@if (Model.Errors.Count > 0)
{
    <div class="card mb-3 border-danger">
        <div class="card-header bg-danger text-white">Lignes invalides</div>
        <div class="card-body p-0">
            <table class="table table-danger mb-0">
                <thead>
                    <tr>
                        <th>Ligne</th>
                        <th>Colonne</th>
                        <th>Erreur</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var err in Model.Errors)
                    {
                        <tr>
                            <td>@err.RowNumber</td>
                            <td>@err.ColumnName</td>
                            <td>@err.Message</td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
}

@if (Model.Duplicates.Count > 0)
{
    <div class="card mb-3 border-warning">
        <div class="card-header bg-warning text-dark">Lignes détectées comme doublons</div>
        <div class="card-body p-0">
            <table class="table table-warning mb-0">
                <thead>
                    <tr>
                        <th>Ligne</th>
                        <th>Prénom</th>
                        <th>Nom</th>
                        <th>Raison</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var dup in Model.Duplicates)
                    {
                        <tr>
                            <td>@dup.RowNumber</td>
                            <td>@dup.FirstName</td>
                            <td>@dup.LastName</td>
                            <td>@dup.MatchedBy</td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
}

@if (Model.ValidRows.Count > 0)
{
    <div class="card mb-3">
        <div class="card-header bg-success text-white">Lignes valides (@Model.ValidRows.Count)</div>
        <div class="card-body p-0">
            <div class="table-responsive">
                <table class="table table-hover mb-0">
                    <thead>
                        <tr>
                            <th>Ligne</th>
                            <th>Prénom</th>
                            <th>Nom</th>
                            <th>Email</th>
                            <th>Téléphone</th>
                            <th>Date de naissance</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var row in Model.ValidRows)
                        {
                            <tr class="table-success">
                                <td>@row.RowNumber</td>
                                <td>@row.FirstName</td>
                                <td>@row.LastName</td>
                                <td>@row.Email</td>
                                <td>@row.Phone</td>
                                <td>@row.BirthDate</td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
}

<div class="d-flex gap-2">
    <form method="post">
        <button type="submit" class="btn btn-primary" @(Model.ValidRows.Count == 0 ? "disabled" : "")>
            Confirmer l'import (@Model.ValidRows.Count client(s))
        </button>
    </form>
    <a asp-page="Index" class="btn btn-outline-secondary">Annuler</a>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
