@page
@model Pierre.Web.Pages.Admin.ConsultationNotes.CreateModel
@{
    ViewData["Title"] = "Nouvelle note de consultation";
}

<h1>Nouvelle note de consultation</h1>

<form method="post">
    <div asp-validation-summary="ModelOnly" class="alert alert-danger" role="alert"></div>

    <input type="hidden" asp-for="Input.ClientId" />

    <div class="row mb-3">
        <div class="col-md-4">
            <label class="form-label">Client</label>
            <p class="form-control-plaintext">@Model.ClientName</p>
        </div>
    </div>

    <div class="row mb-3">
        <div class="col-md-3">
            <label asp-for="Input.Date" class="form-label">Date de la consultation</label>
            <input asp-for="Input.Date" type="date" class="form-control" />
            <span asp-validation-for="Input.Date" class="text-danger"></span>
        </div>
        <div class="col-md-2">
            <label asp-for="Input.Weight" class="form-label">Poids (kg)</label>
            <input asp-for="Input.Weight" class="form-control" type="number" step="0.1" min="0" max="300" />
            <span asp-validation-for="Input.Weight" class="text-danger"></span>
        </div>
    </div>

    <div class="row mb-3">
        <div class="col-md-6">
            <label asp-for="Input.AppointmentId" class="form-label">Rendez-vous associé (optionnel)</label>
            <select asp-for="Input.AppointmentId" asp-items="Model.AppointmentOptions" class="form-select">
                <option value="">-- Aucun --</option>
            </select>
            <span asp-validation-for="Input.AppointmentId" class="text-danger"></span>
        </div>
    </div>

    <div class="row mb-3">
        <div class="col-md-8">
            <label asp-for="Input.Content" class="form-label">Contenu de la note</label>
            <textarea asp-for="Input.Content" class="form-control" rows="6"></textarea>
            <span asp-validation-for="Input.Content" class="text-danger"></span>
        </div>
    </div>

    <div class="row mb-3">
        <div class="col-md-8">
            <label asp-for="Input.Recommendations" class="form-label">Recommandations (optionnel)</label>
            <textarea asp-for="Input.Recommendations" class="form-control" rows="4"></textarea>
            <span asp-validation-for="Input.Recommendations" class="text-danger"></span>
        </div>
    </div>

    <button type="submit" class="btn btn-primary">Créer la note</button>
    <a asp-page="/Admin/Clients/Detail" asp-route-id="@Model.Input.ClientId" class="btn btn-outline-secondary">Annuler</a>
</form>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
