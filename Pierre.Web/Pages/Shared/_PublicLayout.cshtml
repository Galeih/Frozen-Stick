<!DOCTYPE html>
<html lang="fr">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Pierre Diététicien</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/Pierre.Web.styles.css" asp-append-version="true" />
</head>
<body>
    <header class="sticky-top">
        <nav class="navbar navbar-expand-lg navbar-light bg-white border-bottom">
            <div class="container">
                <a class="navbar-brand fw-bold text-primary-green" asp-page="/Public/Index">
                    Pierre Diététicien
                </a>
                <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#mainNav"
                        aria-controls="mainNav" aria-expanded="false" aria-label="Toggle navigation">
                    <span class="navbar-toggler-icon"></span>
                </button>
                <div class="collapse navbar-collapse" id="mainNav">
                    <ul class="navbar-nav me-auto mb-2 mb-lg-0">
                        <li class="nav-item">
                            <a class="nav-link" asp-page="/Public/Index">Accueil</a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link" asp-page="/Public/Presentation">Présentation</a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link" asp-page="/Public/Services">Prestations</a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link" asp-page="/Public/Contents/Index">Blog</a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link" asp-page="/Public/Contact">Contact</a>
                        </li>
                    </ul>
                    <a asp-page="/Public/Booking/Request" class="btn btn-accent rounded-pill px-4">Prendre RDV</a>
                </div>
            </div>
        </nav>
    </header>

    <main>
        @RenderBody()
    </main>

    <footer class="bg-dark text-white py-5">
        <div class="container">
            <div class="row">
                <div class="col-md-4 mb-4">
                    <h5 class="fw-bold">Pierre Diététicien</h5>
                    <p class="text-muted small">Diététicien-nutritionniste à votre écoute pour un accompagnement personnalisé vers une alimentation équilibrée.</p>
                </div>
                <div class="col-md-4 mb-4">
                    <h5>Liens utiles</h5>
                    <ul class="list-unstyled small">
                        <li class="mb-1"><a asp-page="/Public/Index" class="text-muted text-decoration-none">Accueil</a></li>
                        <li class="mb-1"><a asp-page="/Public/Presentation" class="text-muted text-decoration-none">Présentation</a></li>
                        <li class="mb-1"><a asp-page="/Public/Services" class="text-muted text-decoration-none">Prestations</a></li>
                        <li class="mb-1"><a asp-page="/Public/Contents/Index" class="text-muted text-decoration-none">Blog</a></li>
                        <li class="mb-1"><a asp-page="/Public/Contact" class="text-muted text-decoration-none">Contact</a></li>
                        <li class="mb-1"><a asp-page="/Public/Booking/Request" class="text-muted text-decoration-none">Prendre RDV</a></li>
                    </ul>
                </div>
                <div class="col-md-4 mb-4">
                    <h5>Contact</h5>
                    <ul class="list-unstyled small">
                        <li class="mb-1"><a href="tel:+33123456789" class="text-muted text-decoration-none">01 23 45 67 89</a></li>
                        <li class="mb-1"><a href="mailto:contact@pierre-dieteticien.fr" class="text-muted text-decoration-none">contact@pierre-dieteticien.fr</a></li>
                    </ul>
                    <div class="mt-3">
                        <a href="#" class="text-muted me-3 text-decoration-none" aria-label="Facebook">Facebook</a>
                        <a href="#" class="text-muted me-3 text-decoration-none" aria-label="Instagram">Instagram</a>
                        <a href="#" class="text-muted text-decoration-none" aria-label="LinkedIn">LinkedIn</a>
                    </div>
                </div>
            </div>
            <div class="border-top border-secondary pt-3 mt-3 text-center small text-muted">
                &copy; @DateTime.Now.Year - Pierre Diététicien - <a asp-page="/Privacy" class="text-muted">Mentions légales</a>
            </div>
        </div>
    </footer>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>

    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
